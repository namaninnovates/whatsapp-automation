# ---------------------------------------------------------------
# Server-side configuration. NEVER prefix secrets with VITE_.
# ---------------------------------------------------------------

# PostgreSQL (docker compose provides these defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_automation"
# Separate database used by the API integration tests (it is wiped on every test run)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/wa_automation_test"

# API server
PORT=4000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"
# Long random string used to sign session tokens (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
# 32-byte key, base64 encoded, for AES-256-GCM encryption of stored secrets (helper in apps/api/src/lib/crypto.ts;
# WhatsApp/AI credentials are currently read from this file, not stored in the database)
# (openssl rand -base64 32)
ENCRYPTION_KEY="change-me-base64-32-bytes"
LOG_LEVEL=info
# Serve the built web app from the API (production single-process mode)
SERVE_WEB=false

# ---------------------------------------------------------------
# WhatsApp Business Platform (Cloud API). Leave empty to use the simulated channel.
# ---------------------------------------------------------------
WHATSAPP_MODE=simulated            # simulated | cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=               # used to validate X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=             # any string you also enter in the Meta webhook settings
WHATSAPP_API_VERSION=v21.0
# Organization slug that receives Cloud API traffic for the phone number above
WHATSAPP_ORG_SLUG=brightlane-home

# ---------------------------------------------------------------
# AI provider. "mock" works offline with deterministic responses.
# ---------------------------------------------------------------
AI_PROVIDER=mock                   # mock | anthropic | openai
AI_API_KEY=
AI_MODEL=
# Optional for OpenAI-compatible endpoints
AI_BASE_URL=

# Browser variables live in apps/web/.env (see apps/web/.env.example). Vite never reads this file.
